@startuml
title Arquitetura Geral do Sistema

left to right direction
skinparam shadowing false
skinparam linetype ortho
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam defaultTextAlignment center
skinparam nodesep 70
skinparam ranksep 70

actor "Jogador" as Player

rectangle "Plataforma de jogo\nPC / Xbox / PS4 / PS5" as Game #EAF2FF {
  component "Simulador" as Simulator
  component "Emissor de telemetria UDP" as GameTelemetry
}

cloud "Rede local" as Lan #EEF7EE

rectangle "ESP32\nFirmware" as Firmware #FFF6DD {
  component "Portal Wi-Fi" as WifiPortal
  component "Servico de telemetria" as TelemetryService
  component "Cluster de\ninstrumentos" as Cluster
  component "Servico de display" as Display
}

rectangle "Painel fisico" as Panel #F8F8F8 {
  component "Velocimetro" as SpeedGauge
  component "Conta-giros" as RpmGauge
  component "Combustivel" as FuelGauge
  component "Temperatura" as TempGauge
  component "Display TFT" as Tft
  component "Botao de layout" as Button
}

' layout interno
Simulator -[hidden]right- GameTelemetry
WifiPortal -[hidden]down- TelemetryService
TelemetryService -[hidden]down- Cluster
Cluster -[hidden]right- Display

SpeedGauge -[hidden]right- RpmGauge
RpmGauge -[hidden]right- FuelGauge
FuelGauge -[hidden]right- TempGauge
TempGauge -[hidden]down- Tft
Tft -[hidden]left- Button

' ===================== CONEXÕES SEM LABEL =====================

Player --> Simulator
Simulator --> GameTelemetry
GameTelemetry --> Lan

Lan --> WifiPortal
Lan --> TelemetryService

TelemetryService --> Cluster
TelemetryService --> Display

Cluster --> SpeedGauge
Cluster --> RpmGauge
Cluster --> FuelGauge
Cluster --> TempGauge

Button --> Display
Display --> Tft

Player --> Panel

' ===================== LABELS COMO NOTES =====================

note left of Simulator
dirige
end note

note right of Simulator
gera dados
end note

note top of Lan
envia UDP
end note

note right of Lan
conexao
end note

note bottom of Lan
telemetria
end note

note right of TelemetryService
velocidade / rpm
combustivel / temperatura
end note

note right of Display
marcha / status
volta / posicao
end note

note right of Button
troca layout
end note

note right of Tft
renderiza UI
end note

note bottom of Panel
observa
end note

@enduml