@startuml
title Diagrama de Classes do Núcleo do Firmware

top to bottom direction

skinparam shadowing false
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam defaultTextAlignment center

skinparam nodesep 14
skinparam ranksep 22
skinparam wrapWidth 110

skinparam defaultFontSize 13
skinparam classFontSize 13
skinparam classAttributeFontSize 11
skinparam classStereotypeFontSize 11
skinparam packageFontSize 14
skinparam ArrowFontSize 10
skinparam noteFontSize 10

hide empty members

package "Domínio\nsrc/domain" as Domain #F7F7F7 {
  class TelemetryFrame {
    +valid: bool
    +timestampMs: uint32_t
    +speedKmh: float
    +rpm: uint16_t
    +gear: int8_t
    +lapNumber: uint16_t
    +racePosition: uint8_t
    +fuel: float
    +tireTempFL: float
    +tireTempFR: float
    +tireTempRL: float
    +tireTempRR: float
    +tireTempAvg: float
    +invalidate()
  }

  class UiStatus {
    +ssid: char[33]
    +wifiConnected: bool
    +ip: char[16]
    +telemetryValid: bool
    +telemetrySignalPresent: bool
    +telemetryInputStatus: TelemetryInputStatus
    +telemetryDiscardedPackets: uint32_t
    +telemetryReceiveErrors: uint32_t
    +speedKmh: float
    +rpm: int
    +gear: int
    +lapNumber: int
    +racePosition: int
    +fuel: float
    +tireTempAvg: float
    +tireTempFL: float
    +tireTempFR: float
    +tireTempRL: float
    +tireTempRR: float
    +setSsid(value: const char*)
    +setIp(value: const char*)
  }

  enum TelemetryInputStatus {
    Idle
    NoPacket
    PacketReceived
    PacketDiscarded
    ReceiveError
  }

  TelemetryFrame -[hidden]right- UiStatus
  UiStatus -[hidden]right- TelemetryInputStatus
}

package "Aplicação\nsrc/application" as Application #EAF2FF {

  class App {
    +begin(cfg: AppConfig)
    +tick()
  }

  class TelemetryService {
    +begin(port: uint16_t): bool
    +tick()
    +hasValidTelemetry(): bool
    +hasAnySignal(): bool
    +inputStatus(): TelemetryInputStatus
    +lastFrame(): const TelemetryFrame&
    +discardedPacketCount(): uint32_t
    +receiveErrorCount(): uint32_t
    +speedKmh(): float
    +rpm(): float
    +gear(): int
    +lapNumber(): int
    +racePosition(): int
    +fuelLevel(): float
    +tireTempAvgC(): float
    +tireTempFLC(): float
    +tireTempFRC(): float
    +tireTempRLC(): float
    +tireTempRRC(): float
  }

  class InstrumentCluster {
    +begin()
    +setSpeedKmh(speedKmh: float)
    +setRpm(rpm: float)
    +setFuelLevel(fuelLevel: float)
    +setTireTemperature(temperatureC: float)
    +tick(nowMicros: uint32_t)
  }

  App -[hidden]right- TelemetryService
  TelemetryService -[hidden]right- InstrumentCluster
}

package "Instrumentos\nsrc/application/instruments" as Instruments #EEF7EE {

  interface IInstrument

  class SpeedGauge
  class RpmGauge
  class FuelGauge
  class TireTempGauge

  IInstrument -[hidden]right- SpeedGauge
  SpeedGauge -[hidden]right- RpmGauge
  RpmGauge -[hidden]right- FuelGauge
  FuelGauge -[hidden]right- TireTempGauge
}

package "Portas\nsrc/ports" as Ports #FFF6DD {

  interface IWifiConfigPortal
  interface IButtonInput
  interface IClock

  interface ITelemetrySource
  interface IPacketReceiver
  interface ITelemetryDecoder

  interface IStatusDisplay
  interface IInstrumentCluster
  interface IGaugeMotor

  ' IStatusDisplay also exposes showMessage used during init
  IStatusDisplay -[hidden]right- showMessage

  IWifiConfigPortal -[hidden]right- IButtonInput
  IButtonInput -[hidden]right- IClock

  ITelemetrySource -[hidden]right- IPacketReceiver
  IPacketReceiver -[hidden]right- ITelemetryDecoder

  IStatusDisplay -[hidden]right- IInstrumentCluster
  IInstrumentCluster -[hidden]right- IGaugeMotor

  IClock -[hidden]down- ITelemetrySource
  ITelemetryDecoder -[hidden]down- IStatusDisplay
}

package "Adaptadores\nsrc/adapters" as Adapters #FCEFEF {

  class WiFiConfigPortal
  class GpioButtonInput
  class ArduinoClock

  class UdpReceiver
  class Forza7Decoder
  class DisplayService

  interface IDisplayLayout
  class GaugeMotorTmc2208

  WiFiConfigPortal -[hidden]right- GpioButtonInput
  GpioButtonInput -[hidden]right- ArduinoClock

  UdpReceiver -[hidden]right- Forza7Decoder
  Forza7Decoder -[hidden]right- DisplayService

  IDisplayLayout -[hidden]right- GaugeMotorTmc2208

  ArduinoClock -[hidden]down- UdpReceiver
  DisplayService -[hidden]down- IDisplayLayout
}

' Organização vertical dos pacotes
Domain -[hidden]down- Application
Application -[hidden]down- Instruments
Instruments -[hidden]down- Ports
Ports -[hidden]down- Adapters

' Relações de domínio
UiStatus --> TelemetryInputStatus

' Relações centrais da aplicação
App *-- UiStatus
App ..> TelemetryFrame : lê último frame

App --> IWifiConfigPortal
App --> IButtonInput
App --> IClock
App --> ITelemetrySource
App --> IStatusDisplay
App --> IInstrumentCluster

TelemetryService ..|> ITelemetrySource
TelemetryService *-- TelemetryFrame
TelemetryService --> IPacketReceiver
TelemetryService --> ITelemetryDecoder
TelemetryService --> IClock

InstrumentCluster ..|> IInstrumentCluster
InstrumentCluster o-- "1..*" IInstrument

' Display e layouts
DisplayService ..|> IStatusDisplay
DisplayService o-- "1..*" IDisplayLayout
DisplayService --> UiStatus

' Adaptadores concretos
WiFiConfigPortal ..|> IWifiConfigPortal
GpioButtonInput ..|> IButtonInput
ArduinoClock ..|> IClock
UdpReceiver ..|> IPacketReceiver
Forza7Decoder ..|> ITelemetryDecoder
GaugeMotorTmc2208 ..|> IGaugeMotor

' Instrumentos concretos
SpeedGauge ..|> IInstrument
RpmGauge ..|> IInstrument
FuelGauge ..|> IInstrument
TireTempGauge ..|> IInstrument

SpeedGauge --> IGaugeMotor
SpeedGauge --> IClock

RpmGauge --> IGaugeMotor
RpmGauge --> IClock

FuelGauge --> IGaugeMotor
FuelGauge --> IClock

TireTempGauge --> IGaugeMotor
TireTempGauge --> IClock

legend bottom
|= Observações do diagrama |
| App: classe orquestradora do firmware; coordena Wi-Fi, telemetria, instrumentos, botão de layout e interface. |
| TelemetryService: transforma pacotes recebidos em estado de telemetria confiável, tratando descarte, erro e timeout. |
| DisplayService: usa layouts concretos do display, omitidos para preservar a legibilidade. |
| Instrumentos: SpeedGauge, RpmGauge, FuelGauge e TireTempGauge representam o comportamento físico do MVP. |
endlegend

@enduml