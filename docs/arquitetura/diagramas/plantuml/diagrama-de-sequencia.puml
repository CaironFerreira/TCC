@startuml
title Diagrama de Sequencia - Ciclo Principal do Firmware

skinparam shadowing false
skinparam responseMessageBelowArrow true

participant "setup()/loop()" as Runtime
participant App
participant WiFiConfigPortal as Wifi
participant GpioButtonInput as Button
participant ArduinoClock as Clock
participant TelemetryService as Telemetry
participant UdpReceiver as UDP
participant Forza7Decoder as Decoder
participant InstrumentCluster as Cluster
participant "IInstrument[*]" as Instrument
participant DisplayService as Display

== Inicializacao ==
Runtime -> App : begin(AppConfig)
App -> App : resetStatus()
App -> Button : begin()
App -> Wifi : begin()

alt portal ativo
  App -> Display : begin(layoutId)
  App -> Display : showMessage("Wi-Fi SimHub", ...)
else Wi-Fi ja conectado
  App -> App : startRuntime()
  App -> Display : begin(layoutId)
  App -> Cluster : begin()
  App -> Telemetry : begin(udpPort)
  App -> Clock : nowMs()
  App -> Display : setStatus(UiStatus)
  App -> Display : tick()
else aguardando conexao
  App -> Display : begin(layoutId)
  App -> Display : showMessage("Conectando Wi-Fi", ...)
end

== Operacao ==
loop a cada iteracao de loop()
  Runtime -> App : tick()
  App -> Wifi : tick()

  alt portal ativo
    opt tela do portal ainda nao mostrada
      App -> Display : begin(layoutId)
      App -> Display : showMessage("Wi-Fi SimHub", ...)
    end
  else runtime ainda nao iniciado e Wi-Fi conectado
    App -> App : startRuntime()
    App -> Display : begin(layoutId)
    App -> Cluster : begin()
    App -> Telemetry : begin(udpPort)
    App -> Display : setStatus(UiStatus)
    App -> Display : tick()
  else runtime iniciado
    App -> Clock : nowMs()
    Clock --> App : now
    App -> Clock : nowMicros()
    Clock --> App : nowMicros

    App -> Button : tick(now)
    App -> Button : wasPressed()

    alt botao pressionado
      App -> App : updateFastUiFields()
      App -> Display : setStatus(UiStatus)
      App -> Display : nextLayout()
      App -> Display : tick()
    end

    App -> Telemetry : tick()
    Telemetry -> UDP : receive(buffer, 512)

    alt pacote recebido
      Telemetry -> Decoder : decode(data, len, frame)

      alt frame valido
        Decoder --> Telemetry : TelemetryFrame valido
      else frame invalido
        Telemetry -> Telemetry : descarta frame e mantem estado
      end
    else pacote descartado ou erro de recepcao
      Telemetry -> Telemetry : atualiza contadores / status
    else ausencia de pacote ou timeout
      Telemetry -> Telemetry : atualiza estado de sinal
    end

    App -> Cluster : setSpeedKmh(speed)
    Cluster -> Instrument : apply(speed)
    App -> Cluster : setRpm(rpm)
    Cluster -> Instrument : apply(rpm)

    opt telemetria valida
      App -> Cluster : setFuelLevel(fuel)
      Cluster -> Instrument : apply(fuel)
    end

    opt telemetria valida e intervalo de 5 s
      App -> Cluster : setTireTemperature(temp)
      Cluster -> Instrument : apply(temp)
    end

    App -> Cluster : tick(nowMicros)
    Cluster -> Instrument : tick(nowMicros)

    opt intervalo de 500 ms
      App -> App : updateUiWifiFields()
    end

    opt intervalo de 100 ms
      App -> App : updateFastUiFields()
      App -> Display : setStatus(UiStatus)
      App -> Display : tick()
    end
  end
end

@enduml
